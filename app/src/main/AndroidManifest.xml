<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Nothing Glyph lights (ignored on other phones). -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <!-- Launcher apps: to show the label of the apps named in app_usage triggers.
         com.nothing.thirdparty: the Glyph service the Nothing Glyph SDK binds to. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.nothing.thirdparty" />
    </queries>

    <application
        android:name=".VigilApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Vigil"
        tools:ignore="DataExtractionRules">

        <!-- Glyph SDK: "test" is Nothing's debug key; on Android 16 with targetSdk 36 no key is needed. -->
        <meta-data android:name="NothingKey" android:value="test" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".takeover.TakeoverActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="dev.vigil.takeover"
            android:theme="@style/Theme.Vigil"
            android:turnScreenOn="true"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

    </application>
</manifest>
