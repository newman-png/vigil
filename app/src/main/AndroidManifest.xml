<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- VIGIL is sideloaded, not a Play Store app, so it uses whatever permissions make it reliable. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Call pause: the phone's call state (TelephonyCallback). Granted in SETUP; without it the audio mode is used. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Usage access is granted by the user in system settings (SETUP): the front app for a takeover coming back. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Nothing Glyph lights (ignored on other phones). -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <!-- Launcher apps: the APPS button's apps (labels, launch intents, "label_contains" matches).
         SHOW_ALARMS and DIAL: the clock and phone apps of the APPS button.
         VIEW https: every installed browser is in the pool.
         HOME: the Guard looks up the home screen app, which is never closed (even if it also opens links like a browser).
         com.nothing.thirdparty: the Glyph service the Nothing Glyph SDK binds to. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.nothing.thirdparty" />
    </queries>

    <application
        android:name=".VigilApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Vigil"
        tools:ignore="DataExtractionRules">

        <!-- Glyph SDK: "test" is Nothing's debug key; on Android 16 with targetSdk 36 no key is needed. -->
        <meta-data android:name="NothingKey" android:value="test" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".takeover.TakeoverActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="dev.vigil.takeover"
            android:theme="@style/Theme.Vigil"
            android:turnScreenOn="true"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- The Guard's screens: the pool's wait and blocked screens, and the kill switch's 5-minute wait. Its own task,
             so finishing it returns to the app it stood in front of. -->
        <activity
            android:name=".guard.BlockActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="dev.vigil.guard"
            android:theme="@style/Theme.Vigil" />

        <service
            android:name=".service.VigilService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Personal commitment device: runs the user's own daily protocols at their times and keeps the user's chosen distracting apps closed." />
        </service>

        <!-- The engine's alarm and the TEST screen's alarm. Reached only through VIGIL's own PendingIntents. -->
        <receiver
            android:name=".trigger.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".trigger.TestAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".engine.QuietToggleReceiver"
            android:exported="false" />

        <!-- CONFIRM / DONE on the engine's notices (prayers, stage-3 reminders). -->
        <receiver
            android:name=".engine.NoticeActionReceiver"
            android:exported="false" />

        <!-- Exported so the system can reach it; every action here is a protected broadcast only the system sends,
             and the receiver ignores anything else. -->
        <receiver
            android:name=".trigger.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The adhan trigger: reads the adhan app's prayer notification (and other apps' call notifications). -->
        <service
            android:name=".trigger.AdhanListener"
            android:exported="true"
            android:label="VIGIL adhan trigger"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The Guard: keeps the user's pool apps closed at the times their rules say. An accessibility service that only
             learns which app comes to the front; it cannot read the screen (res/xml/guard_service.xml). -->
        <service
            android:name=".guard.GuardService"
            android:exported="true"
            android:label="VIGIL Guard"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_service" />
        </service>

        <!-- EXPORT: the report and the journal CSV, shared from the cache through the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- adb escape hatch: only the shell and the system hold DUMP. See README. -->
        <receiver
            android:name=".engine.KillSwitchReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.vigil.action.SUSPEND" />
                <action android:name="dev.vigil.action.RESUME" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
